# NewsForge Compose configuration. Copy this file to .env and never commit it.
LLM_PROVIDER=gemini_enterprise
ENABLE_MOCK_AI=false

# Choose one authentication method:
# - Gemini API: set GEMINI_API_KEY (GOOGLE_CLOUD_PROJECT is then optional).
# - Vertex AI: leave GEMINI_API_KEY blank and set GOOGLE_CLOUD_PROJECT; the
#   container will use Application Default Credentials.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_SELECTION_MODEL=gemini-flash-lite-latest
GEMINI_PRODUCTION_MODEL=gemini-flash-lite-latest
GEMINI_TELEMETRY_MODEL=gemini-flash-lite-latest

# Local service ports (change only when a port is already in use).
FRONTEND_PORT=5173
STUDIO_PORT=5174
BACKEND_PORT=8000
MONGO_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Safe browser configuration passed to the public frontend container.
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
