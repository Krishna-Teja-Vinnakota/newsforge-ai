# Local default: app starts with deterministic mock AI.
LLM_PROVIDER=mock
ENABLE_MOCK_AI=true

# Gemini Enterprise on Vertex AI using an API key. Leave GEMINI_API_KEY blank
# to use Application Default Credentials / a service account instead.
# LLM_PROVIDER=gemini_enterprise
# ENABLE_MOCK_AI=false
# GEMINI_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_SELECTION_MODEL=gemini-2.5-flash
# GEMINI_PRODUCTION_MODEL=gemini-2.5-flash
# GEMINI_TELEMETRY_MODEL=gemini-2.5-flash
