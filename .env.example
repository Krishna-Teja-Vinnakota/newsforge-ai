# NewsForge Compose configuration. Copy this file to .env and never commit it.
LLM_PROVIDER=gemini_enterprise
ENABLE_MOCK_AI=false

# Choose one authentication method:
# - Gemini API: set GEMINI_API_KEY (GOOGLE_CLOUD_PROJECT is then optional).
# - Vertex AI: leave GEMINI_API_KEY blank and set GOOGLE_CLOUD_PROJECT; the
#   container will use Application Default Credentials.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_SELECTION_MODEL=gemini-flash-lite-latest
GEMINI_PRODUCTION_MODEL=gemini-flash-lite-latest
GEMINI_TELEMETRY_MODEL=gemini-flash-lite-latest
# Image-capable Gemini model used by the "AI image" hero button (for example
# gemini-3.1-flash-image; check Google's docs for the current ID). Leave blank
# to disable image generation.
GEMINI_IMAGE_MODEL=

# Bootstrap administrator for Studio, created on first start if it does not exist.
# Required: docker compose refuses to start until both are set in your .env.
# Choose your own values; never reuse a real password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=NewsForge Administrator

# Local service ports (change only when a port is already in use).
FRONTEND_PORT=5173
STUDIO_PORT=5174
BACKEND_PORT=8000
MONGO_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Safe browser configuration passed to the public frontend container.
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Audience forecasting. Subscriber reach is ignored while the count is zero.
AUDIENCE_SUBSCRIBER_COUNT=0
AUDIENCE_SUBSCRIBER_VIEW_RATE=0.20
AUDIENCE_FORECAST_MIN_BASELINE_STORIES=3
AUDIENCE_FORECAST_MIN_MODEL_STORIES=30
AGENT_MAX_WEIGHT_DELTA=0.15

# Cached external trend signals. Both switches are deliberately off by default.
TRENDS_REFRESH_ENABLED=false
TRENDS_SCORING_ENABLED=false
TRENDS_REFRESH_MINUTES=30
TRENDS_MAX_TOTAL_ADJUSTMENT=0.10
TRENDS_MAX_AGE_HOURS=6
TRENDS_GEO=US
TRENDS_SOURCES=google_news,weather,government,wikipedia
TRENDS_CONNECTOR_TIMEOUT_SECONDS=5
TRENDS_MAX_SIGNALS_PER_SOURCE=50

# Turn strong, under-covered cached trends into pending leads. Off by default;
# takes effect only once TRENDS_REFRESH_ENABLED is also true (needs cached signals).
TRENDS_LEAD_INTAKE_ENABLED=false
TRENDS_LEAD_MIN_STRENGTH=0.5
TRENDS_LEAD_MAX_PER_REFRESH=5
