APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=newsforge
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=newsforge-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/newsforge-media
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=30
BOOTSTRAP_ADMIN_EMAIL=admin@newsforge.dev
BOOTSTRAP_ADMIN_PASSWORD=NewsForgeAdmin#2026
BOOTSTRAP_ADMIN_DISPLAY_NAME=NewsForge Administrator
LLM_PROVIDER=mock
ENABLE_MOCK_AI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_SELECTION_MODEL=
GEMINI_PRODUCTION_MODEL=
GEMINI_TELEMETRY_MODEL=
GEMINI_EMBEDDING_MODEL=
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_WEIGHT_DELTA=0.15
